{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mockups",
  "version": "0.1.0",
  "identifier": "ee.mockups.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Mockups", "width": 1500, "height": 900, "minWidth": 900, "minHeight": 600, "backgroundColor": "#10141b" }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}
